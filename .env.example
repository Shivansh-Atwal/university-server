PORT=5000
NODE_ENV=development
# Leave empty to use an embedded MongoDB persisted in server/.data (dev only)
MONGODB_URI=
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_URL=http://localhost:5173
# First admin account, created on startup when the database has no admin.
# In development the password defaults to Admin@123 when left unset.
ADMIN_EMAIL=admin@university.edu
#ADMIN_PASSWORD=
